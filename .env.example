# --- Vercel (Next.js) ---
# Required on Vercel for Server Actions (login, API proxy to Worker). Copy these into:
#   Dashboard → Project → Settings → Environment Variables
# Use "Production" (and "Preview" if you test on *.vercel.app preview URLs). Redeploy after changes.
#
# Worker API origin (https://…  or  http://127.0.0.1:8787  for local wrangler dev only).
WORKER_API_URL=http://127.0.0.1:8787

# Must match Cloudflare Worker JWT signing secret (wrangler secret put JWT_SECRET).
WORKER_JWT_SECRET=change-me-in-production-use-wrangler-secret

# --- PocketBase (legacy / migration only) ---
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Optional: path to PocketBase SQLite file so the migration script can copy bcrypt hashes.
# PB_SQLITE_PATH=./pb_data/data.db

# --- E2E / Playwright (optional) ---
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
