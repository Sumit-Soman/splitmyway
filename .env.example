# PocketBase (run locally: npm run pb:serve — or docker compose up -d pocketbase)
POCKETBASE_URL=http://127.0.0.1:8090

# Must match a PocketBase superuser (first run: migration creates admin@splitmyway.local if missing — see pb_migrations/1738000001_dev_superuser.js)
POCKETBASE_ADMIN_EMAIL=admin@splitmyway.local
POCKETBASE_ADMIN_PASSWORD=SplitMyWayLocalDev1!

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: seed script picks these for E2E-style users (defaults match tests/e2e)
# E2E_USER_A_EMAIL=testuser@test.com
# E2E_USER_A_PASSWORD=Test@123
# E2E_USER_B_EMAIL=cooanju@gmail.com
# E2E_USER_B_PASSWORD=Test@123
